# ------------------------------------------------------------------------------
# Docker Compose Environment Configuration
# ------------------------------------------------------------------------------
# Change this to your project's unique name (used to prefix containers & volumes)
COMPOSE_PROJECT_NAME=nasa-wildfires-model

# Host port mapping for Angular development server (default: 4200)
PORT=4200

# Host port mapping for production Nginx container (default: 8080)
PROD_PORT=8080

# ------------------------------------------------------------------------------
# Data access credentials (#23) - fill in your local .env, never commit
# ------------------------------------------------------------------------------
EARTHDATA_TOKEN=
FIRMS_MAP_KEY=
GEE_PROJECT=
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=
